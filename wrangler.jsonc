{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alphaeveweb",
  "compatibility_date": "2026-09-27",
  "main": "./worker/contact.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}

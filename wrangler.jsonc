{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alphaeveweb",
  "compatibility_date": "2026-09-27",
  "main": "./worker/contact.js",
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "alphaeve-cms",
      "database_id": "b20ae4ce-2164-4bb1-9462-0ffa682f9dc5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CMS_MEDIA",
      "bucket_name": "alphaeve-cms-media"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*", "/media/*", "/admin", "/admin/*",
      "/", "/index.html", "/services", "/comics", "/comics/*",
      "/projects", "/projects/*", "/authors", "/authors/*",
      "/about", "/historia", "/packito", "/contacto", "/shop",
      "/sitemap.xml", "/robots.txt"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
